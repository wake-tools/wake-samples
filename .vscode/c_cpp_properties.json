{
  "version": 4,
  "configurations": [
    {
      "name": "Win64 (Wake)",
      "intelliSenseMode": "gcc-x64",
      "cStandard": "c99",
      "compilerPath": "C:/mingw64/bin/gcc.exe",

      "defines": [
        "_WIN32",
        "__TINYC__"
      ],

      "compilerArgs": [
        "-Wno-unused-parameter",
        "-Wno-missing-braces"
      ],

      "includePath": [
        "${workspaceFolder}",
        "${workspaceFolder}/.sm",
        "${env:WAKE_HOME}/runtime/include",
        "${env:WAKE_HOME}/runtime/include/wake-tools/jit-v0.1w",
        "${env:WAKE_HOME}/runtime/include/wake-tools/imgui-v0.1w",
        "${env:WAKE_HOME}/runtime/include/wake-tools/sapp-v0.1w",
        "${env:WAKE_HOME}/runtime/include/wake-tools/sgfx-v0.1w",
        "${env:WAKE_HOME}/runtime/include/wake-tools/sokol-v0.1w",
        "${env:WAKE_HOME}/runtime/module/w32-r/wake-tools/tcc-v0.1w/include"
      ],

      "browse": {
        "path": [
          "${workspaceFolder}",
          "${workspaceFolder}/.sm",
          "${env:WAKE_HOME}/runtime/include",
          "${env:WAKE_HOME}/runtime/include/**",
          "${env:WAKE_HOME}/runtime/include/wake-tools",
          "${env:WAKE_HOME}/runtime/module/w32-r/wake-tools/tcc-v0.1w/include"
        ],
        "limitSymbolsToIncludedHeaders": false
      }
    }
  ]
}
